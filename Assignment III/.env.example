# Copy to .env and fill in your Supabase Session pooler settings.
DB_HOST=your-pooler-host
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.your-project-id
DB_PASSWORD="YOUR-PASSWORD"
DB_SSLMODE=require
# Set a long random value in Render and keep it stable across deployments.
SECRET_KEY=

# Admin access: generate a Werkzeug password hash; never use a plain-text password here.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Temporary testing only: shows Restart test; disable for data collection.
ALLOW_RETEST=false
